# ──────────────────────────────────────────────
# MindMitra Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Lines starting with # are comments.

# ══════════════════════════════════════════════
#  BACKEND (.env in /backend)
# ══════════════════════════════════════════════

# ── Required ──────────────────────────────────

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mindmitra

# Secret used to sign JWT access tokens (generate a long random string)
ACCESS_TOKEN_SECRET=

# Secret used to sign JWT refresh tokens (generate a different random string)
REFRESH_TOKEN_SECRET=

# ── Server ────────────────────────────────────

# Port the backend server listens on (default: 5000)
PORT=5000

# Node environment: development | production
NODE_ENV=development

# Frontend URL — used for CORS and Socket.IO origin
CLIENT_URL=http://localhost:5173

# ── Authentication ────────────────────────────

# Access token expiry (default: 15m)
ACCESS_TOKEN_EXPIRY=15m

# Refresh token expiry (default: 7d)
REFRESH_TOKEN_EXPIRY=7d

# ── Database ──────────────────────────────────

# (MONGO_URI is listed above in Required)

# ── AI / Chat ─────────────────────────────────

# Google Gemini API key for the AI chatbot
GEMINI_API_KEY=

# ── Email (Resend) ───────────────────────────

# Resend API key for transactional emails (verification, notifications)
RESEND_API_KEY=

# Sender email address (default: MindMitra <onboarding@resend.dev>)
EMAIL_FROM=MindMitra <onboarding@resend.dev>

# ── File Upload (Cloudinary) ─────────────────

# Cloudinary credentials for resource file uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate Limiting ─────────────────────────────

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Max requests per window per IP (default: 200)
RATE_LIMIT_MAX=200

# ── WebRTC / TURN (Metered.ca) ───────────────
# Metered.ca provides short-lived rotating TURN credentials for WebRTC.
# Required for video calls to work across different networks (e.g. mobile
# data → WiFi). Without TURN, calls only work on the same LAN/localhost.
#
# Sign up at https://www.metered.ca/ to get your credentials.
# The API key stays server-side and is never sent to the browser.

# Your Metered subdomain (e.g. "yourname.metered.live")
METERED_DOMAIN=

# Your Metered API key
METERED_API_KEY=

# ── WebRTC / TURN (Static fallback) ──────────
# Alternative to Metered: a raw JSON array of ICE servers (STUN and/or
# TURN with fixed long-lived credentials). Only used if METERED_DOMAIN
# and METERED_API_KEY are not set.
#
# Example with just STUN (won't traverse symmetric NATs):
#   ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
#
# Example with TURN (fixed credentials — less secure than Metered):
#   ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
ICE_SERVERS=

# ══════════════════════════════════════════════
#  FRONTEND (.env in /frontend)
# ══════════════════════════════════════════════

# Backend API base URL (default: http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO URL (default: http://localhost:5000)
VITE_SOCKET_URL=http://localhost:5000
